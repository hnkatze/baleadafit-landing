      <!-- Card 3 -->
      <div class="bg-surface-container-lowest p-space-xl rounded-xl shadow-sm hover:shadow-md transition flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-lg bg-surface-container-highest text-primary flex items-center justify-center mb-space-md">
            <span class="material-symbols-outlined text-[26px]" aria-hidden="true">analytics</span>
          </div>
          <h3 class="text-headline-sm font-bold text-on-surface mb-space-xs">
            3. Cero Soporte Bromatológico HN
          </h3>
          <p class="text-body-md text-on-surface-variant leading-relaxed">
