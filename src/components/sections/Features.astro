<section id="gastronomia" class="w-full py-space-2xl bg-surface-container-low/50">
  <div class="max-w-7xl mx-auto px-gutter-desktop">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-space-xl gap-space-md">
